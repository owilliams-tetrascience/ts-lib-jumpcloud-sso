{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@tetrascience-npm/jumpcloud-sso/core": ["./packages/core/src/index.ts"],
      "@tetrascience-npm/jumpcloud-sso/next": ["./packages/next/src/index.ts"],
      "@tetrascience-npm/jumpcloud-sso/express": [
        "./packages/express/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
