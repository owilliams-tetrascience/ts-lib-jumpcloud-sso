# Copy to .env in this directory (`nx dev example-express` loads it via
# tsx --env-file). Never commit .env.

# Where THIS app runs. JumpCloud redirects back to
# ${BASE_URL}${CALLBACK_PATH} — register that exact URL as a redirect URI on
# the JumpCloud app.
BASE_URL=http://localhost:3000
PORT=3000

# Path of the registered redirect URI, relative to BASE_URL. Defaults to
# /callback (express-openid-connect's default). Our JumpCloud application only
# registers the Auth.js-shaped URI shared with example-next, so match it:
CALLBACK_PATH=/api/auth/callback/jumpcloud

# Set to false when BASE_URL is NOT whitelisted as a post_logout_redirect_uri
# on the JumpCloud application: /logout then clears this app's session cookie
# only, leaving the JumpCloud session alive (so a later /login is silent).
# Leaving it unset ends the JumpCloud session too, which JumpCloud rejects
# with `invalid_request` unless the URL is whitelisted.
IDP_LOGOUT=false

# Cookie/session encryption secret (NOT the JumpCloud client secret).
# Generate:  openssl rand -hex 32
SESSION_SECRET=

# JumpCloud OIDC application credentials (Admin Console → SSO Applications).
JUMPCLOUD_CLIENT_ID=
JUMPCLOUD_CLIENT_SECRET=

# Optional — defaults shown. Keep the trailing slash on the issuer!
# JUMPCLOUD_ISSUER=https://oauth.id.jumpcloud.com/
# JUMPCLOUD_GROUPS_CLAIM=group
