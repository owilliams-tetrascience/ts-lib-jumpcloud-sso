# Copy to .env.local (Next.js loads it automatically). Never commit .env.local.

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Session/JWT encryption secret. Generate one:  npx auth secret
# (or:  openssl rand -base64 32)
#
# At least 32 characters, and not a placeholder — the library refuses to start
# otherwise. This secret signs the session JWT that carries your JumpCloud
# groups, so anyone who recovers it can mint a session for any user in any
# group. It is NOT the JumpCloud client secret.
AUTH_SECRET=

# Makes Auth.js derive its own origin from the request's Host header.
#
# ⚠️ Commented out on purpose. Behind a proxy that forwards an attacker's
# X-Forwarded-Host, this lets them steer the post-sign-in redirect to their own
# site (verified: the authjs.callback-url cookie follows the poisoned header).
# JumpCloud still refuses to send the authorization code anywhere unregistered,
# so this is a phishing pivot rather than token theft — but there is no reason
# to accept it. Enable it ONLY for local dev, or for self-hosting behind a
# proxy that strips inbound X-Forwarded-Host. In deployment, prefer AUTH_URL.
# AUTH_TRUST_HOST=true
# AUTH_URL=https://your-app.example.com

# ── JumpCloud OIDC application ──────────────────────────────────────────────
# From JumpCloud Admin Console → SSO Applications → your app.
# Register this redirect URI on the JumpCloud app:
#   http://localhost:3000/api/auth/callback/jumpcloud
JUMPCLOUD_CLIENT_ID=
JUMPCLOUD_CLIENT_SECRET=

# Optional — defaults shown. Keep the trailing slash on the issuer!
# JUMPCLOUD_ISSUER=https://oauth.id.jumpcloud.com/
# This app's claim name lives in ./groups.ts; set this only to override it.
# JUMPCLOUD_GROUPS_CLAIM=groups
